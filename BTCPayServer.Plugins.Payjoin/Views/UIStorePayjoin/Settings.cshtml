@using BTCPayServer.Abstractions.Constants
@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Abstractions.Models
@using BTCPayServer.Client
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model BTCPayServer.Plugins.Payjoin.Models.PayjoinStoreSettingsViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel("Payjoin", "Async Payjoin Settings").SetCategory(WellKnownCategories.Store));
}

<form method="post" permissioned="@Policies.CanModifyStoreSettings">
    <div class="sticky-header">
        <h2 text-translate="true">Async Payjoin Settings</h2>
        <button id="page-primary" type="submit" class="btn btn-primary" text-translate="true">Save</button>
    </div>

    <partial name="_StatusMessage" />

    <div class="row">
        <div class="col-xxl-constrain col-xl-8">
            <div class="form-group">
                <label asp-for="PayjoinV2Enabled" class="form-label" text-translate="true">Enable Async Payjoin</label>
                <input asp-for="PayjoinV2Enabled" type="checkbox" class="form-check-input" />
                <div class="form-text" text-translate="true">Technical protocol: Payjoin V2 (BIP 77).</div>
            </div>

            <div class="form-group">
                <label asp-for="DirectoryUrlsText" class="form-label" text-translate="true">Directory URLs</label>
                <textarea asp-for="DirectoryUrlsText" class="form-control" id="PayjoinDirectoryUrls" rows="3"></textarea>
                <span asp-validation-for="DirectoryUrlsText" class="text-danger"></span>
                <div class="form-text" text-translate="true">Enter one Payjoin directory URL per line. Multiple directories improve resilience when one directory is unavailable.</div>
            </div>

            <div class="form-group">
                <label asp-for="OhttpRelayUrlsText" class="form-label" text-translate="true">OHTTP Relay URLs</label>
                <textarea asp-for="OhttpRelayUrlsText" class="form-control" id="PayjoinOhttpRelayUrls" rows="4"></textarea>
                <span asp-validation-for="OhttpRelayUrlsText" class="text-danger"></span>
                <div class="form-text" text-translate="true">Enter one OHTTP relay URL per line. Multiple relays improve reliability when a relay is unavailable.</div>
            </div>

            <div class="form-group">
                <label asp-for="ColdWalletDerivationScheme" class="form-label" text-translate="true">Cold wallet</label>
                <input asp-for="ColdWalletDerivationScheme" class="form-control" id="PayjoinColdWallet" placeholder="xpub... or output descriptor" />
                <span asp-validation-for="ColdWalletDerivationScheme" class="text-danger"></span>
                <div class="form-text" text-translate="true">Optional. Provide an extended public key or output descriptor for a cold storage wallet. Async Payjoin change outputs will be directed to this wallet, sweeping excess funds to cold storage.</div>
            </div>

            <div class="form-group">
                <label asp-for="MaxFeeRateSatPerVb" class="form-label" text-translate="true">Maximum fee rate (sat/vB)</label>
                <input asp-for="MaxFeeRateSatPerVb" class="form-control" id="PayjoinMaxFeeRate" type="number" min="1" placeholder="automatic" />
                <div class="form-text" text-translate="true">Upper bound for the fee rate a payjoin may reach. Leave empty to follow the network fee estimate.</div>
                <span asp-validation-for="MaxFeeRateSatPerVb" class="text-danger"></span>
            </div>
        </div>
    </div>
</form>
