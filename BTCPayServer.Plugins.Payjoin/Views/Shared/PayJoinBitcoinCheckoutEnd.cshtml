@inject BTCPayServer.Services.BTCPayServerEnvironment Env

<style>
    .payjoin-checkout-controls [data-payjoin-mode] {
        flex: 1 1 0;
        min-width: 0;
    }

    .payjoin-checkout-controls.payjoin-mode-payjoin [data-payjoin-indicator] {
        display: flex;
    }

    .payjoin-checkout-controls:not(.payjoin-mode-payjoin) [data-payjoin-indicator] {
        display: none;
    }
</style>

<script>
(function () {
    if (window.__payjoinCheckoutBound) {
        return;
    }

    window.__payjoinCheckoutBound = true;

    const controlsId = 'PayJoinCheckoutControls';
    const testPaymentId = 'PayJoinCheckoutTestPayment';
    // Fast then slow: Vue can mount late on slow connections. Stops once attached.
    const mountPollFastDelayMs = 100;
    const mountPollSlowDelayMs = 1000;
    const mountPollFastPhaseMs = 2000;
    const mountPollCeilingMs = 120000;
    const runTestEnabled = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Env.CheatMode));
    const runTestEndpoint = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Env.CheatMode ? Url.Action("RunTestPayment", "UIPayJoin") : null));
    // Bounded backoff: each attempt can cost the server an OHTTP bootstrap.
    const payjoinRequestBaseDelayMs = 2000;
    const payjoinRequestMaxDelayMs = 30000;
    const maxPayjoinRequestAttempts = 130;
    const payjoinRequestGiveUpMs = 300000;
    // Separate from the attempt ceiling, since each round restarts the attempt budget.
    const maxPayjoinRequestGiveUpCycles = 12;
    let selectedPaymentMode = null;
    let watchedVm = null;
    let mountPollStartedAt = 0;

    const retryState = {
        invoiceId: null,
        attempts: 0,
        // An invoice id, not a bool: a stale request must not block or clear another invoice's marker.
        inFlightForInvoiceId: null,
        nextAttemptAt: 0,
        timer: null,
        giveUpUntil: 0,
        giveUpCycles: 0,
        stopped: false,
        pausedForInvoiceId: null,
        clearTimer: function () {
            if (this.timer !== null) {
                window.clearTimeout(this.timer);
                this.timer = null;
            }
        },
        // inFlightForInvoiceId is deliberately NOT reset: it belongs to the request, not the invoice.
        resetForInvoice: function (invoiceId) {
            this.invoiceId = invoiceId;
            this.attempts = 0;
            this.nextAttemptAt = 0;
            this.giveUpUntil = 0;
            this.giveUpCycles = 0;
            this.stopped = false;
            this.pausedForInvoiceId = null;
            this.clearTimer();
            selectedPaymentMode = null;
        }
    };

    function getCheckoutVm() {
        const checkout = document.getElementById('Checkout');
        return checkout && checkout.__vue__;
    }

    function getModel() {
        const vm = getCheckoutVm();
        return vm && vm.srvModel;
    }

    function shouldShowControls(model) {
        return model &&
            model.status === 'New' &&
            model.paymentMethodId === 'BTC-CHAIN' &&
            model.payjoinPaymentUrl &&
            model.payjoinPlainBitcoinUrl &&
            model.payjoinPaymentUrl !== model.payjoinPlainBitcoinUrl;
    }

    function isCurrentInvoice(invoiceId) {
        const currentModel = getModel();
        return !!currentModel && currentModel.invoiceId === invoiceId;
    }

    function payjoinRequestDelayMs() {
        return Math.min(
            payjoinRequestBaseDelayMs * Math.pow(2, Math.max(0, retryState.attempts - 1)),
            payjoinRequestMaxDelayMs);
    }

    // A missing model (Vue mid-mount) is NOT a different invoice - treating it so would kill the chain.
    function hasMovedToAnotherInvoice(invoiceId) {
        const currentModel = getModel();
        return !!currentModel && currentModel.invoiceId !== invoiceId;
    }

    function schedulePayjoinRequestRetry(invoiceId) {
        retryState.clearTimer();

        if (retryState.stopped) {
            return;
        }

        if (document.visibilityState === 'hidden') {
            retryState.pausedForInvoiceId = invoiceId;
            return;
        }

        if (retryState.attempts >= maxPayjoinRequestAttempts) {
            console.warn('PayJoin stopped asking for a payment URL after ' + retryState.attempts + ' attempts; reload the page to try again');
            retryState.stopped = true;
            return;
        }

        // This timer also waits out the give-up window; nothing else revisits the chain on a schedule.
        const delay = Math.max(payjoinRequestDelayMs(), retryState.giveUpUntil - Date.now());
        retryState.timer = window.setTimeout(function () {
            retryState.timer = null;
            const currentModel = getModel();
            if (currentModel && currentModel.invoiceId === invoiceId) {
                requestPayjoinPaymentUrl(currentModel);
                return;
            }

            if (!hasMovedToAnotherInvoice(invoiceId) && document.getElementById('Checkout')) {
                schedulePayjoinRequestRetry(invoiceId);
            }
        }, delay);
    }

    // Only bootstraps the first session; the merged URL is built server-side into the checkout model.
    function requestPayjoinPaymentUrl(model) {
        if (model && retryState.invoiceId !== model.invoiceId) {
            retryState.resetForInvoice(model.invoiceId);
        }

        if (retryState.stopped) {
            return;
        }

        if (Date.now() < retryState.giveUpUntil) {
            return;
        }

        if (!model ||
            model.status !== 'New' ||
            model.paymentMethodId !== 'BTC-CHAIN' ||
            !model.payjoinPaymentUrlEndpoint ||
            !model.payjoinPlainBitcoinUrl ||
            model.payjoinPaymentUrl ||
            model.payjoinV2Enabled === false ||
            // In flight FOR THIS invoice; the backoff gates every caller, not only the retry timer.
            retryState.inFlightForInvoiceId === model.invoiceId ||
            Date.now() < retryState.nextAttemptAt) {
            return;
        }

        if (document.visibilityState === 'hidden') {
            retryState.pausedForInvoiceId = model.invoiceId;
            return;
        }

        // A give-up round is spent here; attempts is deliberately NOT reset, or the ceiling never triggers.
        if (retryState.giveUpUntil !== 0) {
            retryState.giveUpUntil = 0;
            retryState.nextAttemptAt = 0;
            retryState.giveUpCycles++;
            if (retryState.giveUpCycles >= maxPayjoinRequestGiveUpCycles) {
                console.warn('PayJoin stopped asking for a payment URL after ' + retryState.giveUpCycles +
                    ' rounds of a "do not retry" answer; reload the page to try again');
                retryState.stopped = true;
                return;
            }
        }

        const requestedInvoiceId = model.invoiceId;
        retryState.inFlightForInvoiceId = requestedInvoiceId;
        retryState.attempts++;
        retryState.pausedForInvoiceId = null;
        fetch(model.payjoinPaymentUrlEndpoint, {
            method: 'GET',
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' }
        })
            .then(function (response) {
                if (response.ok) {
                    return response.json();
                }

                // 4xx is terminal, 5xx retryable; 404 (invoice not ready yet) and 429 (transient) excluded.
                const terminalRefusal = response.status >= 400 && response.status < 500 &&
                    response.status !== 404 && response.status !== 429;
                if (terminalRefusal && isCurrentInvoice(requestedInvoiceId)) {
                    console.warn('PayJoin payment URL endpoint refused the request with ' + response.status + '; not retrying');
                    retryState.giveUpUntil = Date.now() + payjoinRequestGiveUpMs;
                }

                return null;
            })
            .then(payload => refreshCheckoutModel(model, payload))
            .catch(error => console.error('PayJoin payment URL fetch failed', error))
            .finally(function () {
                // Scoped to our own invoice so a newer invoice's in-flight marker survives.
                if (retryState.inFlightForInvoiceId === requestedInvoiceId) {
                    retryState.inFlightForInvoiceId = null;
                }
                retryState.nextAttemptAt = Date.now() + payjoinRequestDelayMs();

                if (hasMovedToAnotherInvoice(requestedInvoiceId)) {
                    return;
                }

                // Rescheduled even on Active: the merged URL may not have reached the model yet.
                if (!retryState.stopped) {
                    schedulePayjoinRequestRetry(requestedInvoiceId);
                }
            });
    }

    // Tolerate PascalCase from the host serializer, warning once so the change is visible.
    function readField(payload, name, warnOnPascal) {
        let value = payload[name];
        if (typeof value === 'undefined') {
            value = payload[name.charAt(0).toUpperCase() + name.slice(1)];
            if (typeof value !== 'undefined' && warnOnPascal) {
                console.warn('PayJoin payment URL response used PascalCase field names; the host serializer no longer matches what this plugin was tested against');
            }
        }
        return value;
    }

    function refreshCheckoutModel(model, payload) {
        if (!payload) {
            return;
        }

        const availabilityStatus = readField(payload, 'status', true);
        if (typeof availabilityStatus === 'undefined') {
            console.error('PayJoin payment URL response has unexpected field names', Object.keys(payload));
            return;
        }

        if (typeof availabilityStatus !== 'string') {
            console.error('PayJoin payment URL response returned a non-string status; the host serializer no longer matches what this plugin was tested against', availabilityStatus);
            return;
        }

        if (availabilityStatus !== 'Active') {
            // Missing field = older server (keep retrying); explicit false ends the chain.
            const retryable = readField(payload, 'retryable', false);
            if (retryable === false && isCurrentInvoice(model.invoiceId)) {
                retryState.giveUpUntil = Date.now() + payjoinRequestGiveUpMs;
            }

            return;
        }

        const vm = getCheckoutVm();
        if (!vm || !vm.srvModel || vm.srvModel.invoiceId !== model.invoiceId) {
            return;
        }

        // fetchData re-runs GetCheckoutModel, where the payjoin URL is merged into the model.
        if (typeof vm.fetchData !== 'function') {
            console.error('PayJoin cannot refresh the checkout model: BTCPay no longer exposes fetchData');
            return;
        }

        // NOT awaited into our chain: a fetchData that never settles must not strand it.
        Promise.resolve(vm.fetchData()).catch(function (error) {
            console.error('PayJoin asked BTCPay to refresh the checkout model and the refresh failed', error);
        });
    }

    function getPaymentFields(model, mode) {
        if (mode === 'standard') {
            return {
                url: model.payjoinPlainBitcoinUrl,
                qr: model.payjoinPlainBitcoinUrlQR
            };
        }

        return {
            url: model.payjoinPaymentUrl,
            qr: model.payjoinPaymentUrlQR
        };
    }

    // The model is the ONLY thing this script writes; Vue owns the DOM attributes.
    function applySelectedPaymentMode(model) {
        if (!shouldShowControls(model)) {
            return;
        }

        const fields = getPaymentFields(model, selectedPaymentMode || 'payjoin');
        if (!fields.url || !fields.qr) {
            return;
        }

        // Guarded so our own write does not re-trigger the watcher.
        if (model.invoiceBitcoinUrl === fields.url && model.invoiceBitcoinUrlQR === fields.qr) {
            return;
        }

        const vm = getCheckoutVm();
        if (vm) {
            vm.srvModel = Object.assign({}, model, {
                invoiceBitcoinUrl: fields.url,
                invoiceBitcoinUrlQR: fields.qr
            });
        }
    }

    function removeById(id) {
        const el = document.getElementById(id);
        if (el) {
            el.remove();
        }
    }

    function getQrContainer() {
        return document.querySelector('#payment .payment-box .qr-container');
    }

    function getPaymentBox() {
        return document.querySelector('#payment .payment-box');
    }

    function buildControls(model) {
        const controls = document.createElement('div');
        controls.id = controlsId;
        controls.className = 'payjoin-checkout-controls mt-3 mb-3';
        controls.innerHTML = [
            '<div class="align-items-center justify-content-center gap-1 text-muted" style="font-size: 0.8125rem;" data-payjoin-indicator>',
            '  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">',
            '    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>',
            '    <polyline points="9 12 11 14 15 10"></polyline>',
            '  </svg>',
            '  <span>Async Payjoin</span>',
            '</div>',
            '<div class="btn-group d-flex w-100 mt-3" role="tablist" aria-label="Bitcoin payment mode">',
            '  <button type="button" class="btn" role="tab" data-payjoin-mode="payjoin">Async Payjoin</button>',
            '  <button type="button" class="btn" role="tab" data-payjoin-mode="standard">Standard Bitcoin</button>',
            '</div>'
        ].join('');

        updateControlState(controls, model);
        return controls;
    }

    function updateTabState(button, active) {
        button.classList.toggle('active', active);
        button.classList.toggle('btn-primary', active);
        button.classList.toggle('btn-outline-secondary', !active);
        // setAttribute is not a no-op when unchanged (classList.toggle is).
        const state = active ? 'true' : 'false';
        if (button.getAttribute('aria-selected') !== state) {
            button.setAttribute('aria-selected', state);
        }

        if (button.getAttribute('aria-pressed') !== state) {
            button.setAttribute('aria-pressed', state);
        }
    }

    function updateControlState(controls, model) {
        const payjoinActive = model.invoiceBitcoinUrl === model.payjoinPaymentUrl;
        // Only the payjoin class: the stylesheet keys the indicator off it and its :not().
        controls.classList.toggle('payjoin-mode-payjoin', payjoinActive);
        updateTabState(controls.querySelector('[data-payjoin-mode="payjoin"]'), payjoinActive);
        updateTabState(controls.querySelector('[data-payjoin-mode="standard"]'),
                       model.invoiceBitcoinUrl === model.payjoinPlainBitcoinUrl);
    }

    function placeControls(controls, qrContainer, paymentBox) {
        if (qrContainer) {
            if (controls.nextElementSibling !== qrContainer) {
                qrContainer.insertAdjacentElement('beforebegin', controls);
            }
            return true;
        }

        if (paymentBox) {
            if (controls.parentElement !== paymentBox || paymentBox.firstElementChild !== controls) {
                paymentBox.prepend(controls);
            }
            return true;
        }

        return false;
    }

    function renderControls() {
        const model = getModel();
        if (!shouldShowControls(model)) {
            removeById(controlsId);
            return;
        }

        const qrContainer = getQrContainer();
        const paymentBox = getPaymentBox();
        if (!qrContainer && !paymentBox) {
            return;
        }

        let controls = document.getElementById(controlsId);
        if (!controls) {
            controls = buildControls(model);
            placeControls(controls, qrContainer, paymentBox);
            return;
        }

        if (placeControls(controls, qrContainer, paymentBox)) {
            updateControlState(controls, model);
        }
    }

    function buildTestPayment(model) {
        const wrapper = document.createElement('div');
        wrapper.id = testPaymentId;
        wrapper.className = 'payjoin-test-payment mt-4';

        const label = document.createElement('label');
        label.className = 'control-label form-label';
        label.textContent = 'Async Payjoin test payment';

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'btn btn-secondary rounded-pill w-100';
        button.dataset.payjoinRunTest = '';
        button.dataset.label = 'Run Async Payjoin test payment';
        button.dataset.testEndpoint = runTestEndpoint || '';
        button.textContent = 'Run Async Payjoin test payment';

        wrapper.appendChild(label);
        wrapper.appendChild(button);
        updateTestPayment(wrapper, model);
        return wrapper;
    }

    function updateTestPayment(testPayment, model) {
        const button = testPayment.querySelector('[data-payjoin-run-test]');
        if (!button) {
            return;
        }

        button.dataset.invoiceId = model.invoiceId || '';
    }

    function renderTestPayment() {
        const model = getModel();
        if (!runTestEnabled || !shouldShowControls(model)) {
            removeById(testPaymentId);
            return;
        }

        const cheatSection = document.querySelector('#checkout-cheating section');
        if (!cheatSection) {
            return;
        }

        let testPayment = document.getElementById(testPaymentId);
        if (!testPayment) {
            testPayment = buildTestPayment(model);
            const fakePaymentForm = cheatSection.querySelector('form#test-payment');
            const mineBlockForm = cheatSection.querySelector('form#mine-block');
            if (fakePaymentForm) {
                fakePaymentForm.insertAdjacentElement('afterend', testPayment);
            } else if (mineBlockForm) {
                mineBlockForm.insertAdjacentElement('beforebegin', testPayment);
            } else {
                cheatSection.appendChild(testPayment);
            }
            return;
        }

        updateTestPayment(testPayment, model);
    }

    function sync() {
        // Every entry point re-tries to subscribe, in case Vue mounted after the startup poll gave up.
        attachModelWatcher();

        const model = getModel();
        requestPayjoinPaymentUrl(model);
        applySelectedPaymentMode(model);
        renderControls();
        renderTestPayment();
    }

    // The watch fires on model changes only, not on a timer - which is why the request chain keeps its own.
    function attachModelWatcher() {
        const vm = getCheckoutVm();
        if (!vm || typeof vm.$watch !== 'function') {
            return false;
        }

        if (watchedVm === vm) {
            return true;
        }

        watchedVm = vm;
        vm.$watch('srvModel', sync);
        return true;
    }

    function pollForCheckout() {
        if (mountPollStartedAt === 0) {
            mountPollStartedAt = Date.now();
        }

        sync();
        if (watchedVm !== null) {
            return;
        }

        const elapsed = Date.now() - mountPollStartedAt;
        if (elapsed >= mountPollCeilingMs) {
            return;
        }

        const delay = elapsed < mountPollFastPhaseMs ? mountPollFastDelayMs : mountPollSlowDelayMs;
        window.setTimeout(pollForCheckout, delay);
    }

    document.addEventListener('click', function (event) {
        const modeButton = event.target.closest('#' + controlsId + ' [data-payjoin-mode]');
        if (!modeButton) {
            return;
        }

        const model = getModel();
        if (!shouldShowControls(model)) {
            return;
        }

        selectedPaymentMode = modeButton.dataset.payjoinMode === 'standard' ? 'standard' : 'payjoin';
        sync();
    });

    // Resumes the chain paused while hidden; nothing else calls into it once the retry timer is gone.
    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState !== 'visible') {
            return;
        }

        sync();

        if (retryState.pausedForInvoiceId === null) {
            return;
        }

        const pausedInvoiceId = retryState.pausedForInvoiceId;
        retryState.pausedForInvoiceId = null;
        if (isCurrentInvoice(pausedInvoiceId)) {
            schedulePayjoinRequestRetry(pausedInvoiceId);
        }
    });

    pollForCheckout();
})();
</script>

@if (Env.CheatMode)
{
    <script>
    (function () {
        const resetDelayMs = 2000;
        if (window.__payjoinRunTestBound) {
            return;
        }

        window.__payjoinRunTestBound = true;

        document.addEventListener('click', async event => {
            const button = event.target.closest('[data-payjoin-run-test]');
            if (!button) {
                return;
            }

            const invoiceId = button.getAttribute('data-invoice-id');
            const endpoint = button.getAttribute('data-test-endpoint');
            if (!invoiceId || !endpoint) {
                return;
            }

            const label = button.getAttribute('data-label') || button.textContent;
            button.disabled = true;
            button.textContent = 'Running...';

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ invoiceId })
                });
                const payload = response.ok ? await response.json() : null;
                if (payload && (payload.succeeded === true || payload.Succeeded === true)) {
                    button.textContent = 'Done';
                    setTimeout(() => {
                        button.textContent = label;
                        button.disabled = false;
                    }, resetDelayMs);
                    return;
                }
            } catch (error) {
                console.error('Payjoin test payment failed', error);
            }

            button.textContent = label;
            button.disabled = false;
        });
    })();
    </script>
}
